+    if ((keycnt & 0x4000u) == 0) return;
+    const uint16_t mask = static_cast<uint16_t>(keycnt & 0x03FFu);
+    if (mask == 0) return;
+    // pressed bits (1 = down) from active-low KEYINPUT
+    const uint16_t pressed =
+        static_cast<uint16_t>((~composed_keyinput()) & 0x03FFu);
+    const uint16_t hits = static_cast<uint16_t>(pressed & mask);
+    const bool match = (keycnt & 0x8000u) ? (hits == mask) : (hits != 0);
+    if (match) request_irq(IrqKeypad);
 }
 
