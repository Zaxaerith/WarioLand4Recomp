+++ b/src/runtime/runtime_arm_default_aborts.cpp
@@ -508,6 +508,29 @@ extern "C" int runtime_bridge_interpret(uint32_t entry_pc, bool entry_thumb,
     cpu.cpsr.t   = entry_thumb;
     cpu.thumb    = entry_thumb;
 
+    // Uninitialized RAM "function" guard: a dispatch into an all-zero
+    // EWRAM/IWRAM window is almost always a stale/zero function pointer
+    // (observed at 0x02000EB0). Interpreting it walks the nop-sled into
+    // data tables and dies later on a fake Undefined. Treat the empty
+    // window as a successful empty subroutine and return to stop_pc.
+    if (entry_pc >= 0x02000000u && entry_pc < 0x04000000u) {
+        std::uint32_t probe = 0;
+        for (int k = 0; k < 4; ++k) {
+            probe |= bus->read32((entry_pc + k * 4u) & ~3u);
+        }
+        if (probe == 0u) {
+            std::fprintf(stderr,
+                "runtime_arm: dispatch into empty RAM pc=0x%08X — treating as "
+                "empty subroutine, return to stop_pc=0x%08X\n",
+                entry_pc, stop_pc);
+            g_cpu.R[15] = stop_pc;
+            if (entry_depth > 0) {
+                runtime_call_stack_restore(entry_stack.data(), entry_depth - 1);
+            }
+            return 1;
+        }
+    }
+
     // ── (3) Interpret the subtree until control returns to stop_pc ──
     // Call-nesting pre-flight (for the gate's depth bound): a stack of the
     // return addresses of currently-open BL/BLX calls. Push when a call branches,
@@ -564,14 +587,27 @@ extern "C" int runtime_bridge_interpret(uint32_t entry_pc, bool entry_thumb,
             // interpreter's own NotImplemented gate — PRINCIPLES.md "Genuine
             // interpreter gaps still abort loudly").
             gbarecomp::store_interp_into_arm_cpu(cpu, g_cpu);
+            const std::uint32_t w = cpu.thumb ? bus->read16(pc) : bus->read32(pc);
             std::fprintf(stderr,
                 "runtime_arm: SELF-HEAL bridge hit interpreter %s at "
-                "pc=0x%08X while bridging dispatch miss 0x%08X. The reference "
-                "interpreter cannot execute this op; add its lowering in "
-                "src/armv4t/interpreter.cpp.\n",
+                "pc=0x%08X while bridging dispatch miss 0x%08X. "
+                "thumb=%d cpsr=0x%08X insn=0x%08X R13=0x%08X R14=0x%08X\n"
+                "  The reference interpreter cannot execute this op; add its "
+                "lowering in src/armv4t/interpreter.cpp.\n",
                 r == armv4t::Interpreter::Result::Undefined ? "Undefined"
                                                             : "NotImplemented",
-                pc, entry_pc);
+                pc, entry_pc,
+                cpu.thumb ? 1 : 0,
+                (static_cast<std::uint32_t>(cpu.cpsr.n) << 31) |
+                    (static_cast<std::uint32_t>(cpu.cpsr.z) << 30) |
+                    (static_cast<std::uint32_t>(cpu.cpsr.c) << 29) |
+                    (static_cast<std::uint32_t>(cpu.cpsr.v) << 28) |
+                    (static_cast<std::uint32_t>(cpu.cpsr.i) << 7) |
+                    (static_cast<std::uint32_t>(cpu.cpsr.f) << 6) |
+                    (static_cast<std::uint32_t>(cpu.cpsr.t) << 5) |
+                    static_cast<std::uint32_t>(cpu.cpsr.mode),
